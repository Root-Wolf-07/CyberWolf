# CYBERWOLF Environment Configuration Template
# Copy this file to .env and configure as needed.

CYBERWOLF_ENV=development
CYBERWOLF_LOG_LEVEL=INFO
CYBERWOLF_ACTIVE_MODE=SAFE_SCAN

# Local SQLite Database
CYBERWOLF_DB_PATH=./database/cyberwolf.db
CYBERWOLF_BACKUP_DIR=./database/backups

# Local AI Engine (Ollama - optional offline fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT=60

# Paths & Directories
CYBERWOLF_REPORTS_DIR=./reports
CYBERWOLF_LOGS_DIR=./logs
CYBERWOLF_KNOWLEDGE_DIR=./knowledge
