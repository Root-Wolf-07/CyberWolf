# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite / Database runtime files
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
database/*.db
database/*.db-shm
database/*.db-wal
database/backups/*
!database/backups/.gitkeep
database/evidence/*
!database/evidence/.gitkeep

# Application runtime logs and reports
logs/*
!logs/.gitkeep
logs/security/*
!logs/security/.gitkeep
reports/*
!reports/.gitkeep

# Environment variables & secrets
.env
.env.*
!.env.example

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~
